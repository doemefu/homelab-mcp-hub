{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(/.env)",
      "Read(/.env.local)",
      "Read(/.env.production)",
      "Read(/.env.development)",
      "Read(/.env.test)",
      "Read(/.env.production.local)",
      "Read(/.env.development.local)",
      "Read(/.env.test.local)",
      "Read(/**/?*.sops.yml)",
      "Read(/**/?*.sops.yaml)",
      "Read(/**/?*.sops.json)",
      "Read(/**/?*.sops.env)",
      "Read(/**/?*.sops.ini)",
      "Read(/**/?*.sops.binary)",
      "Read(/**/*.age)",
      "Read(/**/*.pem)",
      "Edit(/.env)",
      "Edit(/.env.local)",
      "Edit(/.env.production)",
      "Edit(/.env.development)",
      "Edit(/.env.test)",
      "Edit(/.env.production.local)",
      "Edit(/.env.development.local)",
      "Edit(/.env.test.local)",
      "Edit(/**/?*.sops.yml)",
      "Edit(/**/?*.sops.yaml)",
      "Edit(/**/?*.sops.json)",
      "Edit(/**/?*.sops.env)",
      "Edit(/**/?*.sops.ini)",
      "Edit(/**/?*.sops.binary)",
      "Edit(/**/*.age)",
      "Edit(/**/*.pem)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git push * -f)",
      "Bash(git push * +*)",
      "Bash(git push * --mirror*)",
      "Bash(git push --mirror*)",
      "Bash(gh pr merge --admin*)",
      "Bash(gh pr merge * --admin*)",
      "Bash(gh api *pulls/*/merge*)",
      "Bash(gh api *mergePullRequest*)"
    ],
    "ask": [
      "Bash(kubectl apply *)",
      "Bash(kubectl * apply *)",
      "Bash(kubectl delete *)",
      "Bash(kubectl * delete *)",
      "Bash(kubectl patch *)",
      "Bash(kubectl * patch *)"
    ]
  },
  "extraKnownMarketplaces": {
    "homelab": {
      "source": {
        "source": "github",
        "repo": "doemefu/homelab-claude",
        "ref": "v0.1.0"
      }
    }
  },
  "enabledPlugins": {
    "homelab-workflow@homelab": true
  }
}
